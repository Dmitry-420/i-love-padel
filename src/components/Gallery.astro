---
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const shots = [
  {
    src: `${base}/media/projects/11839/ylyxcjUPG.webp`,
    alt: 'Тренер проводит групповое занятие по паделу на корте',
    caption: 'Тренировки с тренером',
    span: 'lg:col-span-2'
  },
  {
    src: `${base}/media/projects/11839/jwymnvUPH.webp`,
    alt: 'Зона отдыха падел-клуба со столом, ракетками и гардеробом',
    caption: 'Зона отдыха',
    span: ''
  }
];
---

<section class="border-b border-ink-line py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5">
    <p class="eyebrow text-lime">Р С’РЎвЂљР СР С•РЎРѓРЎвЂћР ВµРЎР‚Р В°</p>
    <h2 class="display-xl mt-4 max-w-2xl text-3xl sm:text-5xl">Р С™Р В»РЎС“Р В±, Р Р† Р С”Р С•РЎвЂљР С•РЎР‚РЎвЂ№Р в„– Р Р†Р С•Р В·Р Р†РЎР‚Р В°РЎвЂ°Р В°РЎР‹РЎвЂљРЎРѓРЎРЏ</h2>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {shots.map((shot) => (
        <figure class:list={['group relative overflow-hidden border border-ink-line', shot.span]}>
          <img
            src={shot.src}
            alt={shot.alt}
            class="h-full min-h-64 w-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="1200" height="800" loading="lazy"
          />
          <figcaption class="absolute inset-x-0 bottom-0 flex items-center gap-2 bg-gradient-to-t from-ink to-transparent px-6 pb-5 pt-12 text-sm text-bone">
            <Icon name="lucide:camera" class="h-4 w-4 text-lime" />
            {shot.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
