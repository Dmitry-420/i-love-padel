---
import { Icon } from 'astro-icon/components';
import { services } from '../data/club';
---

<section id="services" class="border-b border-ink-line py-20 lg:py-28">
  <div class="mx-auto max-w-7xl px-5">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow text-lime">Услуги</p>
        <h2 class="display-xl mt-4 max-w-2xl text-3xl sm:text-5xl">Один клуб — шесть поводов выйти на корт</h2>
      </div>
      <p class="max-w-sm text-sm text-bone-dim">
        Можно просто арендовать корт, а можно собрать вечер целиком: тренировка, лига, корпоратив и отдых после матча.
      </p>
    </div>
    <div class="mt-12 grid gap-px border border-ink-line bg-ink-line sm:grid-cols-2 lg:grid-cols-3">
      {services.map((item, index) => (
        <article class="group flex flex-col bg-ink p-7 transition-colors hover:bg-ink-soft lg:p-9">
          <div class="flex items-center justify-between">
            <Icon name={item.icon} class="h-7 w-7 text-lime" />
            <span class="eyebrow text-bone-dim">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-6 text-xl text-bone">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-bone-dim">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
