---
import { Icon } from 'astro-icon/components';
import { club } from '../data/club';
---

<header class="sticky top-0 z-50 border-b border-ink-line bg-ink/85 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4" aria-label="Основная навигация">
    <a href="#top" class="flex flex-col leading-none">
      <span class="display-xl text-lg text-bone">Кортвейв</span>
      <span class="eyebrow mt-1 text-lime">padel club</span>
    </a>
    <ul class="hidden items-center gap-7 text-sm text-bone-dim md:flex">
      <li><a href="#services" class="transition-colors hover:text-lime">Услуги</a></li>
      <li><a href="#how"     class="transition-colors hover:text-lime">Как проходит</a></li>
      <li><a href="#tariffs" class="transition-colors hover:text-lime">Тарифы</a></li>
      <li><a href="#faq"     class="transition-colors hover:text-lime">Вопросы</a></li>
    </ul>
    <div class="flex items-center gap-3">
      <a href={`tel:${club.phone.replace(/[^\+\d]/g, '')}`}
         class="hidden text-sm text-bone-dim transition-colors hover:text-lime lg:block">
        {club.phone}
      </a>
      <a href="#booking" class="btn-lime px-5 py-3 text-xs sm:text-sm">Записаться</a>
    </div>
  </nav>
</header>
